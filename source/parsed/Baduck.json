aboonStab.mp3/BaboonStab.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Dying / Killing a Player</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"BaboonDuckDie.mp3\" data-mwprovider=\"local\"><source src=\"/images/BaboonDuckDie.mp3?2bdd8a\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/BaboonDuckDie.mp3/BaboonDuckDie.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr></tbody></table>\n</div>\n<h2><span id=\".3E_Gallery\"></span><span class=\"mw-headline\" id=\"&gt;_Gallery\">&gt; Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:BaduckThreaten.jpg\" class=\"image\" title=\"The Baduck threatening a player.\"><img alt=\"The Baduck threatening a player.\" src=\"/images/thumb/BaduckThreaten.jpg/120px-BaduckThreaten.jpg?10fdba\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/BaduckThreaten.jpg/180px-BaduckThreaten.jpg?10fdba 1.5x, /images/thumb/BaduckThreaten.jpg/240px-BaduckThreaten.jpg?10fdba 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Baduck threatening a player.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:BaduckCorpse.jpg\" class=\"image\" title=\"The corpse of the Baduck.\"><img alt=\"The corpse of the Baduck.\" src=\"/images/thumb/BaduckCorpse.jpg/120px-Baduc