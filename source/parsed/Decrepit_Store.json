images/thumb/StoreApparatusPulled.jpg/231px-StoreApparatusPulled.jpg?7210ec 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The mannequins moving after the apparatus has been pulled.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:15px auto;\"><a href=\"/wiki/File:StoreActiveMannequin.jpg\" class=\"image\" title=\"An active Broken Mannequin.\"><img alt=\"An active Broken Mannequin.\" src=\"/images/thumb/StoreActiveMannequin.jpg/116px-StoreActiveMannequin.jpg?a7fded\" decoding=\"async\" loading=\"lazy\" width=\"116\" height=\"65\" srcset=\"/images/thumb/StoreActiveMannequin.jpg/175px-StoreActiveMannequin.jpg?a7fded 1.5x, /images/thumb/StoreActiveMannequin.jpg/231px-StoreActiveMannequin.jpg?a7fded 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">An active Broken Mannequin.</div>\n\t\t</div></li>\n</ul></div>", "images": ["StoreSecuredArea.jpg", "StoreDisplayRoom1.jpg", "StoreDisplayRoom2.jpg", "StoreOldArea.jpg", "Bigshoelmfao.jpg", "StoreApparatusEntrance.jpg", "StoreApparatusPulled.jpg", "StoreActiveMannequin.jpg", "StoreMain2.jpg"], "cats": []}