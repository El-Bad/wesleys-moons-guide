udio>\n</td></tr>\n<tr>\n<td>Ringing</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"3\" data-mwtitle=\"HeadSwellingRinging.mp3\" data-mwprovider=\"local\"><source src=\"/images/HeadSwellingRinging.mp3?a1821e\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HeadSwellingRinging.mp3/HeadSwellingRinging.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr></tbody></table>\n</div>\n<h2><span id=\".3E_Gallery\"></span><span class=\"mw-headline\" id=\"&gt;_Gallery\">&gt; Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:AssimilatedGrowthGreenhouse.jpg\" class=\"image\" title=\"The Assimilated Growth growing in the Greenhouse.\"><img alt=\"The Assimilated Growth growing in the Greenhouse.\" src=\"/images/thumb/AssimilatedGrowthGreenhouse.jpg/120px-AssimilatedGrowthGreenhouse.jpg?f3de8d\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/AssimilatedGrowthGreenhouse.jpg/180px-AssimilatedGrowthGreenhouse.jpg?f3de8d 1.5x, /images/thumb/AssimilatedGrowthGreenhouse.jpg/240px-AssimilatedGrowthGreenhouse.jpg?f3de8d 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Assimilated Growth growing in the Greenhouse.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:AssimilatedGrowthMain.jpg\" class=\"image\" title=\"Assimilated Growth growing at the main entrance.\"><img alt=\"Assimilated Growth growing at the main entrance.\" src=\"/images/thumb/AssimilatedGrowthMain.jpg/120px-AssimilatedGrowthMain.jpg?2aa918\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/AssimilatedGrowthMain.jpg/180px-AssimilatedGrowthMain.jpg?2aa918 1.5x, /images/thumb/AssimilatedGrowthMain.jpg/240px-AssimilatedGrowthMain.jpg?2aa918 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">Assimilated Growth growing at the main entrance.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:AssimilatedGrowthBurstWarning.jpg\" class=\"image\" title=\"The warning given to players when they&#39;re about to burst.\"><img alt=\"The warning given to players when they&#39;re about to burst.\" src=\"/images/thumb/AssimilatedGrowthBurstWarning.jpg/120px-AssimilatedGrowthBurstWarning.jpg?673dd1\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/AssimilatedGrowthBurstWarning.jpg/180px-AssimilatedGrowthBurstWarning.jpg?673dd1 1.5x, /images/thumb/AssimilatedGrowthBurstWarning.jpg/240px-AssimilatedGrowthBurstWarning.jpg?673dd1 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The warning given to players when they're about to burst.</div>\n\t\t</div></li>\n</ul></div>", "images": ["Assimilated_Growth.jpg", "AssimilatedGrowthGreenhouse.jpg", "AssimilatedGrowthMain.jpg", "AssimilatedGrowthBurstWarning.jpg", "TendrilsGrow.mp3", "TendrilsMove2.mp3", "GrowingInHead1.mp3", "GrowingInHead2.mp3", "GrowingInHead3.mp3", "GrowingInHead4.mp3", "GrowingInHead5.mp3", "HeadSwellingRinging.mp3"], "cats": ["Pages_with_DRUID_infoboxes", "Pages_with_spoilers"]}