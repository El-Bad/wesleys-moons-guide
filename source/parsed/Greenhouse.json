=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">Another part of the Greenhouse.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:GreenhouseApparatus.jpg\" class=\"image\" title=\"The Plasma Apparatus.\"><img alt=\"The Plasma Apparatus.\" src=\"/images/thumb/GreenhouseApparatus.jpg/120px-GreenhouseApparatus.jpg?92e11d\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/GreenhouseApparatus.jpg/180px-GreenhouseApparatus.jpg?92e11d 1.5x, /images/thumb/GreenhouseApparatus.jpg/240px-GreenhouseApparatus.jpg?92e11d 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Plasma Apparatus.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:GreenhouseFlamethrower1.jpg\" class=\"image\" title=\"An inactive sprinkler.\"><img alt=\"An inactive sprinkler.\" src=\"/images/thumb/GreenhouseFlamethrower1.jpg/120px-GreenhouseFlamethrower1.jpg?3574b8\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/GreenhouseFlamethrower1.jpg/180px-GreenhouseFlamethrower1.jpg?3574b8 1.5x, /images/thumb/GreenhouseFlamethrower1.jpg/240px-GreenhouseFlamethrower1.jpg?3574b8 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">An inactive sprinkler.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:GreenhouseFlamethrower2.jpg\" class=\"image\" title=\"An active sprinkler after the apparatus is pulled.\"><img