f=\"/wiki/File:HaileyStuck.jpg\" class=\"image\" title=\"Hailey stuck moving in place on the exterior.\"><img alt=\"Hailey stuck moving in place on the exterior.\" src=\"/images/thumb/HaileyStuck.jpg/120px-HaileyStuck.jpg?8157cf\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/HaileyStuck.jpg/180px-HaileyStuck.jpg?8157cf 1.5x, /images/thumb/HaileyStuck.jpg/240px-HaileyStuck.jpg?8157cf 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">Hailey stuck moving in place on the exterior.</div>\n\t\t</div></li>\n</ul></div>", "images": ["RubberRoomsHaileyChase.jpg", "HaileyReward.jpg", "RubberRoomsHaileySpawn.jpg", "HaileyStuck.jpg", "CurseNoiseA14.mp3", "CoffinChime.mp3", "CoffinCreaking.mp3", "Bellchim2.mp3", "CurseNoiseA1.mp3", "CurseNoiseA2.mp3", "CurseNoiseA3.mp3", "CurseNoiseA4.mp3", "CurseNoiseA5.mp3", "CurseNoiseA6.mp3", "CurseNoiseA7.mp3", "CurseNoiseA8.mp3", "CurseNoiseA9.mp3", "CurseNoiseA10.mp3", "CurseNoiseA11.mp3", "CurseNoiseA12.mp3", "CurseNoiseA13.mp3"], "cats": ["Pages_with_DRUID_infoboxes"]}