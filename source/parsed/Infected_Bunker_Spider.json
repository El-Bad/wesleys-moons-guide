ing=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/InfectedBunkerSpiderArachnophobia.jpg/180px-InfectedBunkerSpiderArachnophobia.jpg?c57c24 1.5x, /images/thumb/InfectedBunkerSpiderArachnophobia.jpg/240px-InfectedBunkerSpiderArachnophobia.jpg?c57c24 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Infected Bunker Spider in Arachnophobia Mode.</div>\n\t\t</div></li>\n</ul></div>", "images": ["Infected_Bunker_Spider.jpg", "InfectedBunkerSpiderExterior.jpg", "InfectedBunkerSpiderWait.jpg", "WebbedAir.jpg", "InfectedBunkerSpiderArachnophobia.jpg", "SpiderWalk.mp3", "SpiderAttack.mp3", "SpiderHit.mp3", "StunSpider.mp3", "SpiderDie.mp3"], "cats": ["Pages_with_DRUID_infoboxes", "Pages_with_spoilers"]}