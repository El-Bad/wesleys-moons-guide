{"title": "Heap", "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"ambox\" style=\"--ambox-color: yellow;\"><div class=\"ambox-icon metadata\"><img alt=\"\" src=\"https://commons.wiki.gg/images/Warning-yellow.svg?81ba8c\" decoding=\"async\" loading=\"lazy\" width=\"48\" height=\"41\" data-file-width=\"378\" data-file-height=\"326\" /></div><div class=\"ambox-content\"><p class=\"ambox-title\">Under Construction</p><p class=\"ambox-text\">This page is under constructon! It's <b>not</b> supposed to be linked anywhere. You can help finishing this page if you trully want to.</p></div></div>\n<div class=\"druid-infobox druid-container noexcerpt\" id=\"druid-container-1\"><div><div class=\"druid-title\">455 Heap</div></div><div class=\"druid-section-container\"><div class=\"druid-main-image\"><div class=\"druid-main-images-labels druid-tabs\"><div class=\"druid-main-images-label druid-tab druid-toggleable druid-title-tab focused\" data-druid=\"1-1\" data-druid-tab-key=\"Icon\">Icon</div></div><a href=\"/wiki/File:Heap_(Icon).png\" class=\"image\"><img alt=\"Heap (Icon).png\" src=\"/images/thumb/Heap_%28Icon%29.png/250px-Heap_%28Icon%29.png?a1328b\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" srcset=\"/images/Heap_%28Icon%29.png?a1328b 1.5x\" data-file-width=\"300\" data-file-height=\"300\" /></a></div></div><div class=\"druid-section-container\"><div data-druid-section=\"LevelInformation\"><div class=\"druid-section druid-section-LevelInformation\">Level Information</div></div><div class=\"druid-row druid-row-Price\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-Price\">Price</div><div class=\"druid-data druid-data-Price druid-data-nonempty\">\n&#9646;0</div></div><div class=\"druid-row druid-row-HazardLevel\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-HazardLevel\">Hazard Level</div><div class=\"druid-data druid-data-HazardLevel druid-data-nonempty\">\nD</div></div><div class=\"druid-row druid-row-SupportedWeather(s)\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-SupportedWeather(s)\">Supported Weather(s)</div><div class=\"druid-data druid-data-SupportedWeather(s) druid-data-nonempty\">\nStormy, Foggy, Flooded, Eclipsed, Earthquakes, Forsaken, Hallowed, Minefield</div></div></div><div class=\"druid-section-container\"><div data-druid-section=\"Technical\"><div class=\"druid-section druid-section-Technical\">Technical</div></div><div class=\"druid-row druid-row-InteriorSizeMultiplier\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-InteriorSizeMultiplier\">Interior Size Multiplier</div><div class=\"druid-data druid-data-InteriorSizeMultiplier druid-data-nonempty\">\n1</div></div><div class=\"druid-row druid-row-InteriorsSpawnChances\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-InteriorsSpawnChances\">Interiors Spawn Chances</div><div class=\"druid-data druid-data-InteriorsSpawnChances druid-data-nonempty\">\nFacility: 0.85%<br />Mansion: 0.003%<br />Mineshaft: 0.003%<br />Atlantean Citadel: 0.03%<br />Carnival: 0.003%<br /><b>Deep Sewers: 84.76%</b><br />Grand Armory: 14.13%<br />Greenhouse: 0.11%<br />Rubber Rooms: 0.11%</div></div><div class=\"druid-row druid-row-MinimumScrap\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-MinimumScrap\">Minimum Scrap</div><div class=\"druid-data druid-data-MinimumScrap druid-data-nonempty\">\n16</div></div><div class=\"druid-row druid-row-MaximumScrap\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-MaximumScrap\">Maximum Scrap</div><div class=\"druid-data druid-data-MaximumScrap druid-data-nonempty\">\n22</div></div><div class=\"druid-row druid-row-SpikeTraps\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-SpikeTraps\">Spike Traps</div><div class=\"druid-data druid-data-SpikeTraps druid-data-nonempty\">\n0 &#8594; 0</div></div><div class=\"druid-row druid-row-Turrets\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-Turrets\">Turrets</div><div class=\"druid-data druid-data-Turrets druid-data-nonempty\">\n0 &#8594; 3</div></div><div class=\"druid-row druid-row-Landmines\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-Landmines\">Landmines</div><div class=\"druid-data druid-data-Landmines druid-data-nonempty\">\n0 &#8594; 6</div></div></div><div class=\"druid-section-container\"><div data-druid-section=\"Entities\"><div class=\"druid-section druid-section-Entities\">Entities</div></div><div class=\"druid-row druid-row-DominantIndoorEntity(s)\" data-druid-section-row=\"Entities\"><div class=\"druid-label druid-label-DominantIndoorEntity(s)\">Dominant Indoor Entity(s)</div><div class=\"druid-data druid-data-DominantIndoorEntity(s) druid-data-nonempty\">\nHoarding Bug, Bunker Spider</div></div><div class=\"druid-row druid-row-DominantOutdoorEntity(s)\" data-druid-section-row=\"Entities\"><div class=\"druid-label druid-label-DominantOutdoorEntity(s)\">Dominant Outdoor Entity(s)</div><div class=\"druid-data druid-data-DominantOutdoorEntity(s) druid-data-nonempty\">\nBaboon Hawk</div></div><div class=\"druid-row druid-row-DaytimePower\" data-druid-section-row=\"Entities\"><div class=\"druid-label druid-label-DaytimePower\">Daytime Power</div><div class=\"druid-data druid-data-DaytimePower druid-data-nonempty\">\n5</div></div><div class=\"druid-row druid-row-ExteriorPower\" data-druid-section-row=\"Entities\"><div class=\"druid-label druid-label-ExteriorPower\">Exterior Power</div><div class=\"druid-data druid-data-ExteriorPower druid-data-nonempty\">\n8</div></div><div class=\"druid-row druid-row-InteriorPower\" data-druid-section-row=\"Entities\"><div class=\"druid-label druid-label-InteriorPower\">Interior Power</div><div class=\"druid-data druid-data-InteriorPower druid-data-nonempty\">\n8</div></div></div></div>\n<div class=\"tocleft\"><div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#&gt;_Moon_Map\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">&gt; Moon Map</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#&gt;_Moon_Info\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">&gt; Moon Info</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#&gt;_Environment\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">&gt; Environment</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Outdoor_Ambience\"><span class=\"tocnumber\">3.1</span> <span class=\"toctext\">Outdoor Ambience</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#&gt;_Weather\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">&gt; Weather</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#&gt;_Moon_Exclusive_Content\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">&gt; Moon Exclusive Content</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-7\"><a href=\"#Mines\"><span class=\"tocnumber\">5.1</span> <span class=\"toctext\">Mines</span></a></li>\n<li class=\"toclevel-2 tocsection-8\"><a href=\"#Major_Story_Spoilers:_Falling_Debris\"><span class=\"tocnumber\">5.2</span> <span class=\"toctext\">Major Story Spoilers: Falling Debris</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-9\"><a href=\"#&gt;_Progression\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">&gt; Progression</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-10\"><a href=\"#Unlocked_By\"><span class=\"tocnumber\">6.1</span> <span class=\"toctext\">Unlocked By</span></a></li>\n<li class=\"toclevel-2 tocsection-11\"><a href=\"#Unlocks\"><span class=\"tocnumber\">6.2</span> <span class=\"toctext\">Unlocks</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-12\"><a href=\"#&gt;_Loot_Table\"><span class=\"tocnumber\">7</span> <span class=\"toctext\">&gt; Loot Table</span></a></li>\n<li class=\"toclevel-1 tocsection-13\"><a href=\"#&gt;_Entities\"><span class=\"tocnumber\">8</span> <span class=\"toctext\">&gt; Entities</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-14\"><a href=\"#Enemy_Spawns_(Interior)\"><span class=\"tocnumber\">8.1</span> <span class=\"toctext\">Enemy Spawns (Interior)</span></a></li>\n<li class=\"toclevel-2 tocsection-15\"><a href=\"#Enemy_Spawns_(Exterior)\"><span class=\"tocnumber\">8.2</span> <span class=\"toctext\">Enemy Spawns (Exterior)</span></a></li>\n<li class=\"toclevel-2 tocsection-16\"><a href=\"#Enemy_Spawns_(Daytime_Enemies)\"><span class=\"tocnumber\">8.3</span> <span class=\"toctext\">Enemy Spawns (Daytime Enemies)</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-17\"><a href=\"#&gt;_Lore\"><span class=\"tocnumber\">9</span> <span class=\"toctext\">&gt; Lore</span></a></li>\n<li class=\"toclevel-1 tocsection-18\"><a href=\"#&gt;_Trivia\"><span class=\"tocnumber\">10</span> <span class=\"toctext\">&gt; Trivia</span></a></li>\n<li class=\"toclevel-1 tocsection-19\"><a href=\"#&gt;_Gallery\"><span class=\"tocnumber\">11</span> <span class=\"toctext\">&gt; Gallery</span></a></li>\n</ul>\n</div>\n</div>\n<p><b>Heaps</b> of trash, the largest disposal area in the region. A place housing disease, parasites and insects at a concentration higher than the most vile places. If you've ever lost something, there's a good chance its here. Disposed. Vanished. Rumors say it wasn't only used to dispose of trash but bodies too.\n</p>\n<h2><span id=\".3E_Moon_Map\"></span><span class=\"mw-headline\" id=\"&gt;_Moon_Map\">&gt; Moon Map</span></h2>\n<h2><span id=\".3E_Moon_Info\"></span><span class=\"mw-headline\" id=\"&gt;_Moon_Info\">&gt; Moon Info</span></h2>\n<table style=\"border: 15px solid #8E8E83; font-size: 135%; font-family: Tomorrow; color: #01A801; border-spacing: 0px;\">\n<tbody><tr>\n<td style=\"padding: 25px; background-color: #151515;\"><b>POPULATION:</b> Abandoned.<br /><br /><b>CONDITIONS:</b> Warm, moist, large amounts of trash.<br /><br /><b>FAUNA:</b> A struggling ecosystem, dominated by insects.\n</td></tr></tbody></table>\n<h2><span id=\".3E_Environment\"></span><span class=\"mw-headline\" id=\"&gt;_Environment\">&gt; Environment</span></h2>\n<p><b>Heap</b> is a massive landfill and its entire terrain is almost entirely covered in hills and mounds trash. Some of this trash includes cars with sometimes functional car alarms, shipping containers, etc. Rubble can be heard dislodging and falling from trash and breaking randomly as well.\n</p><p>Three large cranes can also be seen on the exterior and can be used as landmarkers to help in finding the three large buildings on the exterior, which are the main entrance and fire exits. The crane to the west and slightly south marks the main entrance, the crane to the northwest is to the left of a fire exit, and the hook of the crane to the southeast is placed roughly above another fire exit.\n</p>\n<h3><span class=\"mw-headline\" id=\"Outdoor_Ambience\">Outdoor Ambience</span></h3>\n<p><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"17\" data-mwtitle=\"Etern_outside_loop.wav\" data-mwprovider=\"local\"><source src=\"/images/Etern_outside_loop.wav?be8563\" type=\"audio/wav\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/Etern_outside_loop.wav/Etern_outside_loop.wav.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/Etern_outside_loop.wav/Etern_outside_loop.wav.mp3\" type=\"audio/mpeg\" data-transcodekey=\"mp3\" data-width=\"0\" data-height=\"0\" /></audio>\n</p>\n<h2><span id=\".3E_Weather\"></span><span class=\"mw-headline\" id=\"&gt;_Weather\">&gt; Weather</span></h2>\n<p><b>Heap</b> supports Stormy, Foggy, Flooded, Eclipsed, Earthquakes, Forsaken, Hallowed, and Minefield weather by default.\n</p>\n<h2><span id=\".3E_Moon_Exclusive_Content\"></span><span class=\"mw-headline\" id=\"&gt;_Moon_Exclusive_Content\">&gt; Moon Exclusive Content</span></h2>\n<h3><span class=\"mw-headline\" id=\"Mines\">Mines</span></h3>\n<p><b>Heap</b> naturally generates mines on its exterior. These mines begin beeping faster when a player enters its range and will explode if a player stays too close for too long. Players can safely trigger these mines without taking damage, but they can also deal 30 damage to players or instantly kill players and most entities depending on the proximity to the blast.\n</p>\n<h3><span class=\"mw-headline\" id=\"Major_Story_Spoilers:_Falling_Debris\">Major Story Spoilers: Falling Debris</span></h3>\n<p><span class=\"spoiler-content\" style=\"\"><span>If players decided to overload and blow up <a href=\"/wiki/ResearcherxB\" title=\"ResearcherxB\"><b>ResearcherxB</b></a>, debris from the ship can crash onto <b>Heap's</b> exterior near the main entrance. If players land on <b>Heap</b> in the future on that save file, a mild outbreak of white mold will be present on the exterior and two <a href=\"/wiki/Infected_Bunker_Spider\" title=\"Infected Bunker Spider\"><b>Infected Bunker Spiders</b></a> will spawn on the exterior at the start of the day.</span></span>\n</p>\n<table class=\"article-table mw-collapsible mw-collapsed\" data-expandtext=\"\u25bc\" data-collapsetext=\"\u25b2\">\n<tbody><tr>\n<th>Image <span style=\"padding-left:0.5em;\">&#x2060;</span>\n</th></tr>\n<tr>\n<th><div class=\"center\"><div class=\"floatnone\"><a href=\"/wiki/File:HeapCrash.jpg\" class=\"image\" title=\"The debris and white mold outbreak\"><img alt=\"The debris and white mold outbreak\" src=\"/images/thumb/HeapCrash.jpg/500px-HeapCrash.jpg?e37873\" decoding=\"async\" loading=\"lazy\" width=\"500\" height=\"281\" class=\"thumbborder\" srcset=\"/images/thumb/HeapCrash.jpg/750px-HeapCrash.jpg?e37873 1.5x, /images/thumb/HeapCrash.jpg/1000px-HeapCrash.jpg?e37873 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n</th></tr></tbody></table>\n<h2><span id=\".3E_Progression\"></span><span class=\"mw-headline\" id=\"&gt;_Progression\">&gt; Progression</span></h2>\n<h3><span class=\"mw-headline\" id=\"Unlocked_By\">Unlocked By</span></h3>\n<p><span class=\"spoiler-content\" style=\"\"><span>Crafting a \"Blank floppy disc\" on <a href=\"/wiki/Galetry\" title=\"Galetry\">Galetry</a>, inserting it into the Floppy Disc Machine on the exterior of <a href=\"/wiki/Trite\" title=\"Trite\">Trite</a>, and logging the \"Heap floppy disc\".</span></span>\n</p>\n<h3><span class=\"mw-headline\" id=\"Unlocks\">Unlocks</span></h3>\n<p><span class=\"spoiler-content\" style=\"\"><span><a href=\"/wiki/ResearcherxB\" title=\"ResearcherxB\"><big><b>ResearcherxB:</b></big></a> Heap can be one of the random moons that requires placing a Triangulation Device on its exterior.</span></span>\n</p>\n<h2><span id=\".3E_Loot_Table\"></span><span class=\"mw-headline\" id=\"&gt;_Loot_Table\">&gt; Loot Table</span></h2>\n<div class=\"noresize\">\n<table class=\"wikitable sortable mw-collapsible mw-collapsed\" style=\"text-align: center;\" data-expandtext=\"\u25bc\" data-collapsetext=\"\u25b2\">\n<caption style=\"white-space: nowrap;\">Scrap Items\n</caption>\n<tbody><tr>\n<th>Scrap Name</th>\n<th>Image</th>\n<th>Conductive</th>\n<th>Weight (lbs)</th>\n<th>Min Value</th>\n<th>Avg Value</th>\n<th>Max Value</th>\n<th>Rarity</th>\n<th>Spawn Chance\n</th></tr>\n<tr>\n<td>Bottles</td>\n<td><div class=\"center\"><div class=\"floatnone\"><a href=\"/wiki/File:Bottles.png\" class=\"image\"><img alt=\"Bottles.png\" src=\"/images/thumb/Bottles.png/60px-Bottles.png?7ec3b7\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"item-preview thumbborder\" srcset=\"/images/thumb/Bottles.png/90px-Bottles.png?7ec3b7 1.5x, /images/thumb/Bottles.png/120px-Bottles.png?7ec3b7 2x\" data-file-width=\"1024\" data-file-height=\"1024\" /></a></div></div></td>\n<td>No</td>\n<td>19</td>\n<td>44</td>\n<td>50</td>\n<td>56</td>\n<td>6</td>\n<td>1.89%\n</td></tr>\n<tr>\n<td>Cardboard box</td>\n<td><div class=\"center\"><div class=\"floatnone\"><a href=\"/wiki/File:Cardboard_box.png\" class=\"image\"><img alt=\"Cardboard box.png\" src=\"/images/thumb/Cardboard_box.png/60px-Cardboard_box.png?fb1136\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"item-preview thumbborder\" srcset=\"/images/thumb/Cardboard_box.png/90px-Cardboard_box.png?fb1136 1.5x, /images/thumb/Cardboard_box.png/120px-Cardboard_box.png?fb1136 2x\" data-file-width=\"1024\" data-file-height=\"1024\" /></a></div></div></td>\n<td>No</td>\n<td>4</td>\n<td>28</td>\n<td>36</td>\n<td>44</td>\n<td>19</td>\n<td>5.99%\n</td></tr>\n<tr>\n<td>Cash register</td>\n<td><div class=\"center\"><div class=\"floatnone\"><a href=\"/wiki/File:Cash_register.png\" class=\"image\"><img alt=\"Cash register.png\" src=\"/images/thumb/Cash_register.png/60px-Cash_register.png?6d480e\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"item-preview thumbborder\" srcset=\"/images/thumb/Cash_register.png/90px-Cash_register.png?6d480e 1.5x, /images/thumb/Cash_register.png/120px-Cash_register.png?6d480e 2x\" data-file-width=\"1024\" data-file-height=\"1024\" /></a></div></div></td>\n<td>Yes</td>\n<td>84</td>\n<td>80</td>\n<td>120</td>\n<td>160</td>\n<td>10</td>\n<td>3.15%\n</td></tr>\n<tr>\n<td>Cookie mold pan</td>\n<td><div class=\"center\"><div class=\"floatnone\"><a href=\"/wiki/File:Cookie_mold_pan.png\" class=\"image\"><img alt=\"Cookie mold pan