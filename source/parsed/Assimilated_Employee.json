/li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:AssimilatedEmployeeDeskJob.jpg\" class=\"image\" title=\"The Assimilated Employee at a computer.\"><img alt=\"The Assimilated Employee at a computer.\" src=\"/images/thumb/AssimilatedEmployeeDeskJob.jpg/120px-AssimilatedEmployeeDeskJob.jpg?7daadc\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/AssimilatedEmployeeDeskJob.jpg/180px-AssimilatedEmployeeDeskJob.jpg?7daadc 1.5x, /images/thumb/AssimilatedEmployeeDeskJob.jpg/240px-AssimilatedEmployeeDeskJob.jpg?7daadc 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Assimilated Employee at a computer.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:AssimilatedEmployeeCorpse.jpg\" class=\"image\" title=\"The player&#39;s corpse after killing the Assimilated Employee.\"><img alt=\"The player&#39;s corpse after killing the Assimilated Employee.\" src=\"/images/thumb/AssimilatedEmployeeCorpse.jpg/120px-AssimilatedEmployeeCorpse.jpg?d436d6\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/AssimilatedEmployeeCorpse.jpg/180px-AssimilatedEmployeeCorpse.jpg?d436d6 1.5x, /images/thumb/AssimilatedEmployeeCorpse.jpg/240px-AssimilatedEmployeeCorpse.jpg?d436d6 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The player's corpse after killing the Assimilated Employee.</div>\n\t\t</div></li>\n</ul></div>", "images": ["Assimilated_Employee.jpg", "AssimilatedEmployeeStun.jpg", "AssimilatedEmployeeDeskJob.jpg", "AssimilatedEmployeeCorpse.jpg", "BurstMusic.mp3", "AEBurst.mp3", "TentacleMovements.mp3", "AEBreathing.mp3", "AEStep1.mp3", "AEStep2.mp3", "AEStep3.mp3", "AEWalkQuickly.mp3", "AERoar1.mp3", "AERoar2.mp3", "AERoar3.mp3", "AEBite.mp3"], "cats": ["Pages_with_DRUID_infoboxes", "Pages_with_spoilers"]}