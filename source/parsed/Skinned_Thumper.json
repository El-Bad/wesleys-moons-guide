gRoar3.mp3/LongRoar3.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Short Roar</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"ShortRoar1.mp3\" data-mwprovider=\"local\"><source src=\"/images/ShortRoar1.mp3?fb2883\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/ShortRoar1.mp3/ShortRoar1.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Ramming</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"Ram1.mp3\" data-mwprovider=\"local\"><source src=\"/images/Ram1.mp3?f7368e\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/Ram1.mp3/Ram1.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"Ram2.mp3\" data-mwprovider=\"local\"><source src=\"/images/Ram2.mp3?2c53de\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/Ram2.mp3/Ram2.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"Ram3.mp3\" data-mwprovider=\"local\"><source src=\"/images/Ram3.mp3?82f6fe\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/Ram3.mp3/Ram3.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Biting a Player</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"BitePlayer.mp3\" data-mwprovider=\"local\"><source src=\"/images/BitePlayer.mp3?a36eff\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/BitePlayer.mp3/BitePlayer.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Getting Hit</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"HitCrawler.mp3\" data-mwprovider=\"local\"><source src=\"/images/HitCrawler.mp3?b2b20a\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HitCrawler.mp3/HitCrawler.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"3\" data-mwtitle=\"HitCrawler2.mp3\" data-mwprovider=\"local\"><source src=\"/images/HitCrawler2.mp3?b27c4a\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HitCrawler2.mp3/HitCrawler2.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Dying</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"CrawlerDie.mp3\" data-mwprovider=\"local\"><source src=\"/images/CrawlerDie.mp3?1c42b8\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/CrawlerDie.mp3/CrawlerDie.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr></tbody></table>\n</div>\n<h2><span id=\".3E_Trivia\"></span><span class=\"mw-headline\" id=\"&gt;_Trivia\">&gt; Trivia</span></h2>\n<p>The fifth and flaming <b>Skinned Thumper</b> dropped into the arena has a unique sound effect.<br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"20\" data-mwtitle=\"ThumperOnFire.mp3\" data-mwprovider=\"local\"><source src=\"/images/ThumperOnFire.mp3?2253f7\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/ThumperOnFire.mp3/ThumperOnFire.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</p>\n<h2><span id=\".3E_Gallery\"></span><span class=\"mw-headline\" id=\"&gt;_Gallery\">&gt; Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:GrandArmorySkinnedThumper.jpg\" class=\"image\" title=\"The Skinned Thumpers on hooks prior to starting the event.\"><img alt=\"The Skinned Thumpers on hooks prior to starting the event.\" src=\"/images/thumb/GrandArmorySkinnedThumper.jpg/120px-GrandArmorySkinnedThumper.jpg?5c30d5\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/GrandArmorySkinnedThumper.jpg/180px-GrandArmorySkinnedThumper.jpg?5c30d5 1.5x, /images/thumb/GrandArmorySkinnedThumper.jpg/240px-GrandArmorySkinnedThumper.jpg?5c30d5 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Skinned Thumpers on hooks prior to starting the event.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><