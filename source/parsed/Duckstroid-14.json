{"title": "Duckstroid-14", "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"druid-infobox druid-container noexcerpt\" id=\"druid-container-1\"><div><div class=\"druid-title\">135 Duckstroid-14</div></div><div class=\"druid-section-container\"><div class=\"druid-main-images\"><div class=\"druid-main-images-labels druid-tabs\"><div class=\"druid-main-images-label druid-tab druid-toggleable druid-title-tab focused\" data-druid=\"1-1\" data-druid-tab-key=\"Preview\">Preview</div><div class=\"druid-main-images-label druid-tab druid-toggleable druid-title-tab\" data-druid=\"1-2\" data-druid-tab-key=\"Icon\">Icon</div><div class=\"druid-main-images-label druid-tab druid-toggleable druid-title-tab\" data-druid=\"1-3\" data-druid-tab-key=\"In space\">In space</div></div><div class=\"druid-main-images-files\"><div class=\"druid-main-images-file druid-toggleable focused\" data-druid=\"1-1\" data-druid-tab-key=\"Preview\"><a href=\"/wiki/File:Ducksteroid-14.jpg\" class=\"image\"><img alt=\"Ducksteroid-14.jpg\" src=\"/images/thumb/Ducksteroid-14.jpg/250px-Ducksteroid-14.jpg?d899f4\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"141\" srcset=\"/images/thumb/Ducksteroid-14.jpg/375px-Ducksteroid-14.jpg?d899f4 1.5x, /images/thumb/Ducksteroid-14.jpg/500px-Ducksteroid-14.jpg?d899f4 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div><div class=\"druid-main-images-file druid-toggleable\" data-druid=\"1-2\" data-druid-tab-key=\"Icon\"><a href=\"/wiki/File:Duckstroid-14_(Icon).png\" class=\"image\"><img alt=\"Duckstroid-14 (Icon).png\" src=\"/images/thumb/Duckstroid-14_%28Icon%29.png/250px-Duckstroid-14_%28Icon%29.png?cde10c\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" srcset=\"/images/Duckstroid-14_%28Icon%29.png?cde10c 1.5x\" data-file-width=\"300\" data-file-height=\"300\" /></a></div><div class=\"druid-main-images-file druid-toggleable\" data-druid=\"1-3\" data-druid-tab-key=\"In space\"><a href=\"/wiki/File:Duckstroid-14_in_space.jpg\" class=\"image\"><img alt=\"Duckstroid-14 in space.jpg\" src=\"/images/thumb/Duckstroid-14_in_space.jpg/250px-Duckstroid-14_in_space.jpg?11520b\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"141\" srcset=\"/images/thumb/Duckstroid-14_in_space.jpg/375px-Duckstroid-14_in_space.jpg?11520b 1.5x, /images/thumb/Duckstroid-14_in_space.jpg/500px-Duckstroid-14_in_space.jpg?11520b 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div></div></div><div class=\"druid-section-container\"><div data-druid-section=\"LevelInformation\"><div class=\"druid-section druid-section-LevelInformation\">Level Information</div></div><div class=\"druid-row druid-row-Price\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-Price\">Price</div><div class=\"druid-data druid-data-Price druid-data-nonempty\">\n&#9646;1271</div></div><div class=\"druid-row druid-row-HazardLevel\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-HazardLevel\">Hazard Level</div><div class=\"druid-data druid-data-HazardLevel druid-data-nonempty\">\nQuack</div></div><div class=\"druid-row druid-row-SupportedWeather(s)\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-SupportedWeather(s)\">Supported Weather(s)</div><div class=\"druid-data druid-data-SupportedWeather(s) druid-data-nonempty\">\nRainy, Stormy, Eclipsed, Earthquakes, Forsaken, Hallowed, Hurricane, Minefield</div></div><div class=\"druid-row druid-row-TerrainforCruiser\" data-druid-section-row=\"LevelInformation\"><div class=\"druid-label druid-label-TerrainforCruiser\">Terrain for Cruiser?</div><div class=\"druid-data druid-data-TerrainforCruiser druid-data-nonempty\">\nYes</div></div></div><div class=\"druid-section-container\"><div data-druid-section=\"Technical\"><div class=\"druid-section druid-section-Technical\">Technical</div></div><div class=\"druid-row druid-row-InteriorSizeMultiplier\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-InteriorSizeMultiplier\">Interior Size Multiplier</div><div class=\"druid-data druid-data-InteriorSizeMultiplier druid-data-nonempty\">\n2.7</div></div><div class=\"druid-row druid-row-InteriorsSpawnChances\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-InteriorsSpawnChances\">Interiors Spawn Chances</div><div class=\"druid-data druid-data-InteriorsSpawnChances druid-data-nonempty\">\nFacility: 1.13%<br /><b>Mansion: 83.33%</b><br />Mineshaft: 0.28%<br />Atlantean Citadel: 2.82%<br />Carnival: 0.28%<br />Greenhouse: 0.85%<br />Rubber Rooms: 11.30%</div></div><div class=\"druid-row druid-row-MinimumScrap\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-MinimumScrap\">Minimum Scrap</div><div class=\"druid-data druid-data-MinimumScrap druid-data-nonempty\">\n2</div></div><div class=\"druid-row druid-row-MaximumScrap\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-MaximumScrap\">Maximum Scrap</div><div class=\"druid-data druid-data-MaximumScrap druid-data-nonempty\">\n100</div></div><div class=\"druid-row druid-row-SpikeTraps\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-SpikeTraps\">Spike Traps</div><div class=\"druid-data druid-data-SpikeTraps druid-data-nonempty\">\n0 &#8594; 50</div></div><div class=\"druid-row druid-row-Turrets\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-Turrets\">Turrets</div><div class=\"druid-data druid-data-Turrets druid-data-nonempty\">\n0 &#8594; 50</div></div><div class=\"druid-row druid-row-Landmines\" data-druid-section-row=\"Technical\"><div class=\"druid-label druid-label-Landmines\">Landmines</div><div class=\"druid-data druid-data-Landmines druid-data-nonempty\">\n0 &#8594; 50</div></div></div><div class=\"druid-section-container\"><div data-druid-section=\"Entities\"><div class=\"druid-section druid-section-