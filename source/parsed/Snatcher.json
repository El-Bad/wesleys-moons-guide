=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"4\" data-mwtitle=\"SnatcherRoar2.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherRoar2.mp3?a4ce4a\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherRoar2.mp3/SnatcherRoar2.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Short Roar</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"SnatcherShortRoar.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherShortRoar.mp3?6e0f03\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherShortRoar.mp3/SnatcherShortRoar.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Ramming</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"SnatcherRam1.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherRam1.mp3?4d3011\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherRam1.mp3/SnatcherRam1.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"SnatcherRam2.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherRam2.mp3?52856c\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherRam2.mp3/SnatcherRam2.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"3\" data-mwtitle=\"SnatcherRam3.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherRam3.mp3?4b9327\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherRam3.mp3/SnatcherRam3.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Attacking</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"SnatcherAttack.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherAttack.mp3?976b65\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherAttack.mp3/SnatcherAttack.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Getting Hit</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"SnatcherHurt.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherHurt.mp3?e07e6c\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherHurt.mp3/SnatcherHurt.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio><br /><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"SnatcherHurt2.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherHurt2.mp3?a10769\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherHurt2.mp3/SnatcherHurt2.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Dying</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"4\" data-mwtitle=\"SnatcherDie.mp3\" data-mwprovider=\"local\"><source src=\"/images/SnatcherDie.mp3?7f72d3\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/SnatcherDie.mp3/SnatcherDie.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr></tbody></table>\n</div>\n<h2><span id=\".3E_Trivia\"></span><span class=\"mw-headline\" id=\"&gt;_Trivia\">&gt; Trivia</span></h2>\n<ul><li>The <b>Snatcher</b> players can encounter in the interior is female, as it will appear to protect the deceased male's <b>Snatcher skullplate</b> that can be retrieved from the <a href=\"/wiki/Deep_Sewers#&gt;_Event:_Deep_Maintenance_Elevator\" title=\"Deep Sewers\"><b>Deep Maintenance Elevator Event</b></a>.</li></ul>\n<h2><span id=\".3E_Gallery\"></span><span class=\"mw-headline\" id=\"&gt;_Gallery\">&gt; Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:SnatcherCorpse.jpg\" class=\"image\" title=\"The Snatcher dying.\"><img alt=\"The Snatcher dying.\" src=\"/images/thumb/SnatcherCorpse.jpg/120px-SnatcherCorpse.jpg?846eb2\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/SnatcherCorpse.jpg/180px-SnatcherCorpse.jpg?846eb2 1.5x, /images/thumb/SnatcherCorpse.jpg/240px-SnatcherCorpse.jpg?846eb2 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Snatcher dying.</div>\n\t\t</div></li>\n</ul></div>", "images": ["Snatcher.jpg", "SnatcherCorpse.jpg", "SnatcherRoarDistant.mp3", "SnatcherStep1.mp3", "SnatcherStep2.mp3", "SnatcherStep3.mp3", "SnatcherStep4.mp3", "SnatcherRoar1.mp3", "SnatcherRoar2.mp3", "SnatcherShortRoar.mp3", "SnatcherRam1.mp3", "SnatcherRam2.mp3", "SnatcherRam3.mp3", "SnatcherAttack.mp3", "SnatcherHurt.mp3", "SnatcherHurt2.mp3", "SnatcherDie.mp3"], "cats": ["Pages_with_DRUID_infoboxes"]}