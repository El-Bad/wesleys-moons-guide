ryTone.mp3?e514f4\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HoneyWaspAngryTone.mp3/HoneyWaspAngryTone.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Attacking</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"6\" data-mwtitle=\"HoneyStingerAngry.mp3\" data-mwprovider=\"local\"><source src=\"/images/HoneyStingerAngry.mp3?91905f\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HoneyStingerAngry.mp3/HoneyStingerAngry.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Getting Hit</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"1\" data-mwtitle=\"HoneyWaspHit.mp3\" data-mwprovider=\"local\"><source src=\"/images/HoneyWaspHit.mp3?d75b67\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HoneyWaspHit.mp3/HoneyWaspHit.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr>\n<tr>\n<td>Dying</td>\n<td><audio controls=\"\" preload=\"none\" width=\"320\" style=\"width:320px;max-width:100%;max-height:100%\" data-durationhint=\"2\" data-mwtitle=\"HoneyWaspDie.mp3\" data-mwprovider=\"local\"><source src=\"/images/HoneyWaspDie.mp3?742763\" type=\"audio/mpeg\" data-width=\"0\" data-height=\"0\" /><source src=\"/images/transcoded/HoneyWaspDie.mp3/HoneyWaspDie.mp3.ogg\" type=\"audio/ogg; codecs=&quot;vorbis&quot;\" data-transcodekey=\"ogg\" data-width=\"0\" data-height=\"0\" /></audio>\n</td></tr></tbody></table>\n</div>\n<h2><span id=\".3E_Gallery\"></span><span class=\"mw-headline\" id=\"&gt;_Gallery\">&gt; Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:HoneyStingerAggro.jpg\" class=\"image\" title=\"The Honey Stinger attacking a player.\"><img alt=\"The Honey Stinger attacking a player.\" src=\"/images/thumb/HoneyStingerAggro.jpg/120px-HoneyStingerAggro.jpg?334ab4\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/HoneyStingerAggro.jpg/180px-HoneyStingerAggro.jpg?334ab4 1.5x, /images/thumb/HoneyStingerAggro.jpg/240px-HoneyStingerAggro.jpg?334ab4 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The Honey Stinger attacking a player.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:HoneyStingerDead.jpg\" class=\"image\" title=\"The corpse of the Honey Stinger.\"><img alt=\"The corpse of the Honey Stinger.\" src=\"/images/thumb/HoneyStingerDead.jpg/120px-HoneyStingerDead.jpg?c7d1b7\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" srcset=\"/images/thumb/HoneyStingerDead.jpg/180px-HoneyStingerDead.jpg?c7d1b7 1.5x, /images/thumb/HoneyStingerDead.jpg/240px-HoneyStingerDead.jpg?c7d1b7 2x\" data-file-width=\"1920\" data-file-height=\"1080\" /></a></div></div>\n\t\t\t<div class=\"gallerytext\">The corpse of the Honey Stinger.</div>\n\t\t</div></li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\"><div style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px;\"><div style=\"margin:16px auto;\"><a href=\"/wiki/File:HoneyStingerTreat.jpg\" class=\"image\" title=\"The Honey stinger treat available for purchase in the Gift Shop.\"><img alt=\"The Honey stinger treat available for p